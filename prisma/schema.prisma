  lastRunAt   DateTime?  @map("last_run_at")
  runCount    Int        @default(0) @map("run_count")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPublic])
  @@map("saved_filters")
}

model Portfolio {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  name        String
  description String?
  currency    String          @default("TWD")
  isDefault   Boolean         @default(false) @map("is_default")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  items       PortfolioItem[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portfolios")
}

model PortfolioItem {
  id          String    @id @default(uuid())
  portfolioId String    @map("portfolio_id")
  assetType   AssetType @map("asset_type")
  assetId     String    @map("asset_id")
  assetCode   String    @map("asset_code")
  assetName   String    @map("asset_name")
  weight      Decimal   @db.Decimal(6, 4)
  shares      Decimal?  @db.Decimal(14, 4)
  avgCost     Decimal?  @map("avg_cost") @db.Decimal(14, 4)
  currency    String    @default("TWD")
  note        String?
  addedAt     DateTime  @default(now()) @map("added_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([assetType, assetId])
  @@map("portfolio_items")
}

model Alert {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  assetType     AssetType? @map("asset_type")
  assetId       String?    @map("asset_id")
  alertType     AlertType  @map("alert_type")
  field         String
  operator      String
  threshold     Decimal    @db.Decimal(14, 4)
  isActive      Boolean    @default(true) @map("is_active")
  triggeredAt   DateTime?  @map("triggered_at")
  lastCheckedAt DateTime?  @map("last_checked_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([assetType, assetId])
  @@map("alerts")
}

model SeriesTag {
  id         String   @id @default(uuid())
  seriesType String   @map("series_type")
  seriesId   String   @map("series_id")
  tag        String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([seriesType, seriesId, tag])
  @@index([tag])
  @@map("series_tags")
}

model Stock {
  id                  String           @id @default(uuid())
  ticker              String
  yahooSymbol         String           @unique @map("yahoo_symbol")
  exchange            String
  country             String
  currency            String
  companyName         String           @map("company_name")
  companyNameZh       String?          @map("company_name_zh")
  sector              String?
  industry            String?
  status              StockStatus      @default(ACTIVE)
  latestClose         Decimal?         @map("latest_close") @db.Decimal(16, 4)
  latestDate          DateTime?        @map("latest_date") @db.Date
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  historyBackfilledAt DateTime?        @map("history_backfilled_at")
  history             StockHistory[]
  technical           StockTechnical[]

  @@unique([ticker, exchange])
  @@index([exchange])
  @@index([country])
  @@index([historyBackfilledAt])
  @@map("stocks")
}

model StockHistory {
  id            String   @id @default(uuid())
  stockId       String   @map("stock_id")
  date          DateTime @db.Date
  open          Decimal? @db.Decimal(16, 4)
  high          Decimal? @db.Decimal(16, 4)
  low           Decimal? @db.Decimal(16, 4)
  close         Decimal  @db.Decimal(16, 4)
  adjustedClose Decimal? @map("adjusted_close") @db.Decimal(16, 4)
  volume        Decimal? @db.Decimal(20, 0)
  source        String?  @map("source")
  sourceSymbol  String?  @map("source_symbol")
  providerMethod String? @map("provider_method")
  importedAt    DateTime? @map("imported_at")
  updatedAt     DateTime? @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  stock         Stock    @relation(fields: [stockId], references: [id])

  @@unique([stockId, date])
  @@index([stockId, date])
  @@map("stock_history")
}

model ProductionSchedulerRun {
  id          String    @id
  jobId       String    @map("job_id")
  exchange    String
  runType     String    @map("run_type")
  status      String
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  attempted   Int       @default(0)
  completed   Int       @default(0)
  inserted    Int       @default(0)
  updated     Int       @default(0)
  failed      Int       @default(0)
  details     Json?
  error       String?

  @@index([jobId, startedAt])
  @@map("production_scheduler_runs")
}

model ProductionSchedulerLock {
  jobId     String   @id @map("job_id")
  owner     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("production_scheduler_locks")
}

model ProductionSchedulerFailure {
  jobId           String   @map("job_id")
  stockId         String   @map("stock_id")
  symbol          String
  attempts        Int      @default(1)
  lastError       String   @map("last_error")
  lastAttemptedAt DateTime @default(now()) @map("last_attempted_at")

  @@id([jobId, stockId])
  @@index([jobId])
  @@map("production_scheduler_failures")
}

model ProductCoverageSnapshot {
  id               String   @id @default(uuid())
  productType      String   @map("product_type")
  productId        String   @map("product_id")
  historyRows      BigInt   @default(0) @map("history_rows")
  firstDate        DateTime? @map("first_date") @db.Date
  latestDate       DateTime? @map("latest_date") @db.Date
  coveragePercent  Decimal? @map("coverage_percent") @db.Decimal(7, 4)
  lastCalculatedAt DateTime @default(now()) @map("last_calculated_at")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([productType, productId])
  @@index([productType, latestDate])
  @@map("product_coverage_snapshot")
}

model StockTechnical {
  id              String   @id @default(uuid())
  stockId         String   @map("stock_id")
  date            DateTime @db.Date
  ma5             Decimal? @db.Decimal(16, 4)
  ma20            Decimal? @db.Decimal(16, 4)
  ma60            Decimal? @db.Decimal(16, 4)
  ma120           Decimal? @db.Decimal(16, 4)
  ma240           Decimal? @db.Decimal(16, 4)
  ema12           Decimal? @db.Decimal(16, 4)
  ema26           Decimal? @db.Decimal(16, 4)
  macd            Decimal? @map("macd") @db.Decimal(16, 4)
  macdSignal      Decimal? @map("macd_signal") @db.Decimal(16, 4)
  macdHistogram   Decimal? @map("macd_histogram") @db.Decimal(16, 4)
  kdK             Decimal? @map("kd_k") @db.Decimal(8, 4)
  kdD             Decimal? @map("kd_d") @db.Decimal(8, 4)
  rsi14           Decimal? @db.Decimal(8, 4)
  atr14           Decimal? @db.Decimal(16, 4)
  bollingerUpper  Decimal? @map("bollinger_upper") @db.Decimal(16, 4)
  bollingerMiddle Decimal? @map("bollinger_middle") @db.Decimal(16, 4)
  bollingerLower  Decimal? @map("bollinger_lower") @db.Decimal(16, 4)
  createdAt       DateTime @default(now()) @map("created_at")
  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, date])
  @@index([stockId, date])
  @@map("stock_technical")
}

model DataSource {
  id              String             @id @default(uuid())
  name            String
  category        DataSourceCategory
  country         String?
  website         String?
  coverage        String?
  historySupport  Boolean            @default(false) @map("history_support")
  apiSupport      Boolean            @default(false) @map("api_support")
  parserAvailable Boolean            @default(false) @map("parser_available")
  license         String?
  status          DataSourceStatus
  reliability     Int?               @db.SmallInt
  rejectionReason String?            @map("rejection_reason")
  lastVerifiedAt  DateTime?          @map("last_verified_at")
  lastSuccessAt   DateTime?          @map("last_success_at")
  owner           String?
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([name, category])
  @@index([category, status])
  @@map("data_sources")
}

enum Plan {
  FREE
  PREMIUM
  TEAM
}

enum AssetType {
  ETF
  FUND
  INSURANCE
  DISCRETIONARY
  RETIREMENT
  REIT
}

enum Logic {
  AND
  OR
}

enum MatchStatus {
  ACTIVE
  REMOVED
}

enum MarketType {
  INDEX
  COMMODITY
  FOREX
  BOND
  VOLATILITY
  CRYPTO
}

enum EconomicFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum EconomicImportance {
  LOW
  MEDIUM
  HIGH
}

enum ModuleType {
  ETF_SCREENER
  FUND_SCREENER
  CRITERIA_BUILDER
  COMPARE
  WATCHLIST
  PORTFOLIO
  ALERT
  CHART
  NOTE
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  YIELD_ABOVE
  YIELD_BELOW
  RETURN_ABOVE
  RETURN_BELOW
  CRITERIA_MATCH_CHANGE
}

enum StockStatus {
  ACTIVE
  DELISTED
  SUSPENDED
  UNKNOWN
}

enum DataSourceStatus {
  PRODUCTION
  VERIFIED
  CANDIDATE
  REJECTED
}

enum DataSourceCategory {
  STOCK
  ETF
  FUND
  INSURANCE_LINKED
  MACRO
  FX
  COMMODITY
  CRYPTO
  BOND
}
