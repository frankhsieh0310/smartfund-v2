  workerObservedAt      DateTime             @default(now()) @map("worker_observed_at")
  details               Json?
  registry              DatasetRegistry      @relation(fields: [datasetKey], references: [datasetKey], onDelete: Cascade)
  healthStates          DatasetHealthState[]

  @@index([datasetKey, workerObservedAt])
  @@map("dataset_runtime_observations")
}

model DatasetCoverageObservation {
  id                   String               @id @default(uuid()) @db.Uuid
  datasetKey           String               @map("dataset_key")
  masterCount          Int?                 @map("master_count")
  targetCount          Int?                 @map("target_count")
  everSuccessCount     Int?                 @map("ever_success_count")
  currentCount         Int?                 @map("current_count")
  staleCount           Int?                 @map("stale_count")
  neverSyncedCount     Int?                 @map("never_synced_count")
  outsideScopeCount    Int?                 @map("outside_scope_count")
  latestObservationAt  DateTime?            @map("latest_observation_at")
  lastCanonicalWriteAt DateTime?            @map("last_canonical_write_at")
  coveragePercent      Decimal?             @map("coverage_percent") @db.Decimal(7, 4)
  currentPercent       Decimal?             @map("current_percent") @db.Decimal(7, 4)
  rawLatestAt          DateTime?            @map("raw_latest_at")
  rawRows              BigInt?              @map("raw_rows")
  canonicalLatestAt    DateTime?            @map("canonical_latest_at")
  canonicalRows        BigInt?              @map("canonical_rows")
  promotionLagSeconds  BigInt?              @map("promotion_lag_seconds")
  rawLayerStatus       String               @default("RAW_LAYER_NOT_AVAILABLE") @map("raw_layer_status")
  observedAt           DateTime             @default(now()) @map("observed_at")
  details              Json?
  registry             DatasetRegistry      @relation(fields: [datasetKey], references: [datasetKey], onDelete: Cascade)
  healthStates         DatasetHealthState[]

  @@index([datasetKey, observedAt])
  @@map("dataset_coverage_observations")
}

model DatasetHealthState {
  datasetKey            String                      @id @map("dataset_key")
  healthState           String                      @map("health_state")
  reasonCodes           Json                        @map("reason_codes")
  runtimeObservationId  String?                     @map("runtime_observation_id") @db.Uuid
  coverageObservationId String?                     @map("coverage_observation_id") @db.Uuid
  conditionStartedAt    DateTime                    @default(now()) @map("condition_started_at")
  evaluatedAt           DateTime                    @default(now()) @map("evaluated_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  registry              DatasetRegistry             @relation(fields: [datasetKey], references: [datasetKey], onDelete: Cascade)
  runtimeObservation    DatasetRuntimeObservation?  @relation(fields: [runtimeObservationId], references: [id], onDelete: SetNull)
  coverageObservation   DatasetCoverageObservation? @relation(fields: [coverageObservationId], references: [id], onDelete: SetNull)

  @@index([healthState, evaluatedAt])
  @@map("dataset_health_states")
}

model DatasetAlertEvent {
  id              String          @id @default(uuid()) @db.Uuid
  datasetKey      String          @map("dataset_key")
  condition       String
  status          String          @default("OPEN")
  severity        String
  dedupeKey       String          @map("dedupe_key")
  firstObservedAt DateTime        @default(now()) @map("first_observed_at")
  lastObservedAt  DateTime        @default(now()) @map("last_observed_at")
  resolvedAt      DateTime?       @map("resolved_at")
  occurrenceCount Int             @default(1) @map("occurrence_count")
  details         Json?
  registry        DatasetRegistry @relation(fields: [datasetKey], references: [datasetKey], onDelete: Cascade)

  @@index([status, condition, lastObservedAt])
  @@map("dataset_alert_events")
}
