generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                     @id @default(uuid())
  supabaseId            String                     @unique @map("supabase_id")
  email                 String                     @unique
  displayName           String?                    @map("display_name")
  avatarUrl             String?                    @map("avatar_url")
  plan                  Plan                       @default(FREE)
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  alerts                Alert[]
  auditLogs             AuditLog[]
  compareSessions       CompareSession[]
  favorites             Favorite[]
  investorQuestionnaire InvestorQuestionnaire?
  notifications         Notification[]
  portfolios            Portfolio[]
  savedFilters          SavedFilter[]
  searchLogs            SearchLog[]
  strategies            Strategy[]
  strategyFavorites     StrategyFavorite[]
  criteria              UserCriteria[]
  workspace             Workspace?
  watchlists            Watchlist[]                @relation("WatchlistOwner")
  watchlistEvents       WatchlistMembershipEvent[] @relation("WatchlistEventActor")

  @@map("users")
}

model InvestorQuestionnaire {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  answers              Json
  investorProfile      Json     @map("profile")
  questionnaireVersion Int      @default(1) @map("questionnaire_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_questionnaires")
}

model UserCriteria {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  name          String
  description   String?
  isActive      Boolean             @default(true) @map("is_active")
  version       Int                 @default(1)
  lastRunAt     DateTime?           @map("last_run_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  conditions    CriteriaCondition[]
  matches       CriteriaMatch[]
  results       CriteriaResult[]
  versions      CriteriaVersion[]
  notifications Notification[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_criteria")
}

model CriteriaCondition {
  id         String       @id @default(uuid())
  criteriaId String       @map("criteria_id")
  groupId    Int          @map("group_id")
  logic      Logic        @default(OR)
  field      String
  operator   String
  value      String
  valueType  String       @default("string") @map("value_type")
  period     String?
  priority   Int          @default(0)
  sortOrder  Int          @default(0) @map("sort_order")
  createdAt  DateTime     @default(now()) @map("created_at")
  criteria   UserCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([criteriaId])
  @@map("criteria_conditions")
}

model CriteriaResult {
  id          String          @id @default(uuid())
  criteriaId  String          @map("criteria_id")
  runAt       DateTime        @default(now()) @map("run_at")
  etfCount    Int             @default(0) @map("etf_count")
  fundCount   Int             @default(0) @map("fund_count")
  totalCount  Int             @default(0) @map("total_count")
  prevTotal   Int             @default(0) @map("prev_total")
  triggeredBy String          @default("user") @map("triggered_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  matches     CriteriaMatch[]
  criteria    UserCriteria    @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([criteriaId, runAt])
  @@map("criteria_results")
}

model CriteriaMatch {
  id               String         @id @default(uuid())
  criteriaResultId String         @map("criteria_result_id")
  criteriaId       String         @map("criteria_id")
  assetType        AssetType      @map("asset_type")
  assetId          String         @map("asset_id")
  assetName        String         @map("asset_name")
  status           MatchStatus    @default(ACTIVE)
  matchedReason    Json?          @map("matched_reason")
  removedReason    Json?          @map("removed_reason")
  firstMatchedAt   DateTime       @default(now()) @map("first_matched_at")
  lastMatchedAt    DateTime       @default(now()) @map("last_matched_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  criteria         UserCriteria   @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  result           CriteriaResult @relation(fields: [criteriaResultId], references: [id], onDelete: Cascade)

  @@index([criteriaId, status])
  @@index([assetType, assetId])
  @@map("criteria_matches")
}

model CriteriaVersion {
  id         String       @id @default(uuid())
  criteriaId String       @map("criteria_id")
  version    Int
  name       String
  conditions Json
  changedBy  String       @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  isCurrent  Boolean      @default(true) @map("is_current")
  criteria   UserCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@map("criteria_versions")
}

model Asset {
  id               String               @id @default(uuid())
  assetType        AssetType            @map("asset_type")
  code             String?
  isin             String?
  name             String
  nameEn           String?              @map("name_en")
  provider         String?
  currency         String               @default("TWD")
  region           String?
  category         String?
  distributionFreq String?              @map("distribution_freq")
  riskLevel        Int?                 @map("risk_level")
  inceptionDate    DateTime?            @map("inception_date")
  platform         String?
  sourceUrl        String?              @map("source_url")
  lastCrawledAt    DateTime?            @map("last_crawled_at")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  aum              Decimal?             @db.Decimal(18, 2)
  expenseRatio     Decimal?             @map("expense_ratio") @db.Decimal(6, 4)
  benchmark        String?
  performances     AssetPerformance[]
  distributions    Distribution[]
  etf              Etf?
  favorites        Favorite[]
  fund             Fund?
  holdings         Holding[]
  holdingSnapshots EtfHoldingSnapshot[]
  flows            EtfFlow[]
  searchIndex      SearchIndex?

  @@index([assetType])
  @@index([code])
  @@index([isin])
  @@map("assets")
}

model AssetPerformance {
  id            String   @id @default(uuid())
  assetId       String   @map("asset_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  return1d      Decimal? @map("return_1d") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  aum           Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
  @@map("asset_performances")
}

model Etf {
  id                  String                  @id @default(uuid())
  code                String                  @unique
  name                String
  nameEn              String?                 @map("name_en")
  isin                String?                 @unique
  provider            String
  exchange            String?
  currency            String                  @default("TWD")
  category            String?
  region              String?
  sector              String?
  benchmark           String?
  distributionFreq    String?                 @map("distribution_freq")
  inceptionDate       DateTime?               @map("inception_date")
  isActive            Boolean                 @default(true) @map("is_active")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  optionContracts     OptionContract[]        @relation("OptionEtfUnderlying")
  latestNav           Decimal?                @map("latest_nav") @db.Decimal(14, 4)
  latestPrice         Decimal?                @map("latest_price") @db.Decimal(14, 4)
  premium             Decimal?                @db.Decimal(8, 4)
  aum                 Decimal?                @db.Decimal(18, 2)
  expenseRatio        Decimal?                @map("expense_ratio") @db.Decimal(6, 4)
  dividendYield       Decimal?                @map("dividend_yield") @db.Decimal(8, 4)
  volume              Decimal?                @db.Decimal(20, 0)
  returnYtd           Decimal?                @map("return_ytd") @db.Decimal(8, 4)
  return1m            Decimal?                @map("return_1m") @db.Decimal(8, 4)
  return3m            Decimal?                @map("return_3m") @db.Decimal(8, 4)
  return6m            Decimal?                @map("return_6m") @db.Decimal(8, 4)
  return1y            Decimal?                @map("return_1y") @db.Decimal(8, 4)
  return3y            Decimal?                @map("return_3y") @db.Decimal(8, 4)
  return5y            Decimal?                @map("return_5y") @db.Decimal(8, 4)
  return10y           Decimal?                @map("return_10y") @db.Decimal(8, 4)
  volatility1y        Decimal?                @map("volatility_1y") @db.Decimal(8, 4)
  sharpe1y            Decimal?                @map("sharpe_1y") @db.Decimal(8, 4)
  beta                Decimal?                @db.Decimal(8, 4)
  alpha               Decimal?                @db.Decimal(8, 4)
  stdDev              Decimal?                @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown         Decimal?                @map("max_drawdown") @db.Decimal(8, 4)
  priceUpdatedAt      DateTime?               @map("price_updated_at")
  distributionCheckedAt DateTime?             @map("distribution_checked_at")
  assetId             String?                 @unique @map("asset_id")
  dataProvider        String?                 @map("data_provider")
  dataSource          String?                 @map("data_source")
  knowledgeTags       AssetKnowledgeTag[]
  distributions       Distribution[]
  distributionEvents  EtfDistributionEvent[]
  history             EtfHistory[]
  performances        EtfPerformance[]
  asset               Asset?                  @relation(fields: [assetId], references: [id])
  holdings            Holding[]
  EtfFlow             EtfFlow[]
  EtfHoldingSnapshot  EtfHoldingSnapshot[]
  issuerMapping       EtfIssuerMapping?
  sharesHistory       EtfSharesOutstanding[]
  creationRedemptions EtfCreationRedemption[]
  flowAggregates      EtfFlowAggregate[]
  flowCoverage        EtfFlowCoverage?

  @@index([code])
  @@index([region, sector])
  @@index([distributionFreq])
  @@index([dividendYield])
  @@index([return1y])
  @@map("etfs")
}

model EtfDistributionEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  etfId              String    @map("etf_id")
  shareClassId       String    @default("PRIMARY") @map("share_class_id")
  exDate             DateTime  @map("ex_date") @db.Date
  recordDate         DateTime? @map("record_date") @db.Date
  paymentDate        DateTime? @map("payment_date") @db.Date
  announcementDate   DateTime? @map("announcement_date") @db.Date
  effectiveDate      DateTime  @map("effective_date") @db.Date
  amount             Decimal   @db.Decimal(24, 10)
  currency           String
  distributionType   String?   @map("distribution_type")
  source             String
  sourceRecordId     String    @map("source_record_id")
  verificationStatus String    @map("verification_status")
  importedAt         DateTime  @default(now()) @map("imported_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  etf                Etf       @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([etfId, shareClassId, exDate, source, sourceRecordId])
  @@index([etfId, exDate])
  @@index([source, verificationStatus])
  @@map("etf_distribution_events")
}

model EtfFlow {
  id                 String    @id @default(uuid()) @db.Uuid
  etfId              String    @map("etf_id")
  observationDate    DateTime  @map("observation_date") @db.Date
  flowValue          Decimal   @map("flow_value") @db.Decimal(28, 6)
  currency           String
  flowMethod         String    @map("flow_method")
  source             String
  sourceReference    String    @map("source_reference")
  calculationInputs  Json?     @map("calculation_inputs")
  currentShares      Decimal?  @map("current_shares") @db.Decimal(30, 6)
  priorShares        Decimal?  @map("prior_shares") @db.Decimal(30, 6)
  navUsed            Decimal?  @map("nav_used") @db.Decimal(30, 10)
  navDate            DateTime? @map("nav_date") @db.Date
  aum                Decimal?  @db.Decimal(30, 6)
  sourceRecordId     String?   @map("source_record_id")
  sourceType         String    @default("ISSUER_OFFICIAL") @map("source_type")
  verificationStatus String    @default("UNVERIFIED_LEGACY") @map("verification_status")
  qualityStatus      String    @default("UNKNOWN") @map("quality_status")
  freshnessStatus    String    @default("UNKNOWN") @map("freshness_status")
  licenseStatus      String    @default("TERMS_REVIEW_REQUIRED") @map("license_status")
  retrievedAt        DateTime? @map("retrieved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  etf                Etf       @relation(fields: [etfId], references: [id])
  Asset              Asset?    @relation(fields: [assetId], references: [id])
  assetId            String?

  @@unique([etfId, observationDate, flowMethod, source])
  @@index([observationDate])
  @@map("etf_flows")
}

model EtfIssuer {
  id                 String             @id @db.Uuid
  code               String             @unique
  officialName       String             @map("official_name")
  officialUrl        String             @map("official_url")
  sourceStatus       String             @map("source_status")
  verificationStatus String             @map("verification_status")
  licenseStatus      String             @map("license_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  etfs               EtfIssuerMapping[]

  @@map("etf_issuers")
}

model EtfIssuerMapping {
  etfId              String    @id @map("etf_id")
  issuerId           String    @map("issuer_id") @db.Uuid
  source             String
  verificationStatus String    @map("verification_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  etf                Etf       @relation(fields: [etfId], references: [id])
  issuer             EtfIssuer @relation(fields: [issuerId], references: [id])

  @@index([issuerId])
  @@map("etf_issuer_mappings")
}

model EtfSharesOutstanding {
  id                 String    @id @db.Uuid
  etfId              String    @map("etf_id")
  observationDate    DateTime  @map("observation_date") @db.Date
  sharesOutstanding  Decimal   @map("shares_outstanding") @db.Decimal(30, 6)
  source             String
  sourceRecordId     String?   @map("source_record_id")
  sourceUrl          String?   @map("source_url")
  publicationDate    DateTime? @map("publication_date") @db.Date
  retrievedAt        DateTime  @map("retrieved_at")
  verificationStatus String    @map("verification_status")
  qualityStatus      String    @map("quality_status")
  licenseStatus      String    @map("license_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  etf                Etf       @relation(fields: [etfId], references: [id])

  @@unique([etfId, observationDate, source])
  @@index([etfId, observationDate])
  @@map("etf_shares_outstanding")
}

model EtfCreationRedemption {
  id                 String   @id @db.Uuid
  etfId              String   @map("etf_id")
  observationDate    DateTime @map("observation_date") @db.Date
  createdShares      Decimal? @map("created_shares") @db.Decimal(30, 6)
  createdUnits       Decimal? @map("created_units") @db.Decimal(30, 6)
  creationValue      Decimal? @map("creation_value") @db.Decimal(30, 6)
  redeemedShares     Decimal? @map("redeemed_shares") @db.Decimal(30, 6)
  redeemedUnits      Decimal? @map("redeemed_units") @db.Decimal(30, 6)
  redemptionValue    Decimal? @map("redemption_value") @db.Decimal(30, 6)
  currency           String?
  source             String
  sourceRecordId     String?  @map("source_record_id")
  sourceUrl          String?  @map("source_url")
  retrievedAt        DateTime @map("retrieved_at")
  verificationStatus String   @map("verification_status")
  licenseStatus      String   @map("license_status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  etf                Etf      @relation(fields: [etfId], references: [id])

  @@unique([etfId, observationDate, source])
  @@map("etf_creation_redemptions")
}

model EtfFlowAggregate {
  id                 String    @id @db.Uuid
  etfId              String    @map("etf_id")
  asOfDate           DateTime  @map("as_of_date") @db.Date
  window             String    @map("window_name")
  flowValue          Decimal   @map("flow_value") @db.Decimal(30, 6)
  currency           String
  flowPercentAum     Decimal?  @map("flow_percent_aum") @db.Decimal(18, 10)
  aumAsOfDate        DateTime? @map("aum_as_of_date") @db.Date
  calculationMethod  String    @map("calculation_method")
  verificationStatus String    @map("verification_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  etf                Etf       @relation(fields: [etfId], references: [id])

  @@unique([etfId, asOfDate, window, currency])
  @@map("etf_flow_aggregates")
}

model EtfFlowCoverage {
  etfId                String    @id @map("etf_id")
  issuerId             String?   @map("issuer_id") @db.Uuid
  sourceStatus         String    @map("source_status")
  sharesStatus         String    @map("shares_status")
  sharesHistoryStatus  String    @map("shares_history_status")
  navStatus            String    @map("nav_status")
  aumStatus            String    @map("aum_status")
  dailyFlowStatus      String    @map("daily_flow_status")
  flowMethod           String?   @map("flow_method")
  historyCount         Int       @default(0) @map("history_count")
  firstFlowDate        DateTime? @map("first_flow_date") @db.Date
  latestFlowDate       DateTime? @map("latest_flow_date") @db.Date
  weeklyStatus         String    @map("weekly_status")
  monthlyStatus        String    @map("monthly_status")
  ytdStatus            String    @map("ytd_status")
  normalizedFlowStatus String    @map("normalized_flow_status")
  provenanceStatus     String    @map("provenance_status")
  freshnessStatus      String    @map("freshness_status")
  licenseStatus        String    @map("license_status")
  coverageStatus       String    @map("coverage_status")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  etf                  Etf       @relation(fields: [etfId], references: [id])

  @@index([issuerId, coverageStatus])
  @@map("etf_flow_coverage")
}

model EtfPerformance {
  id            String   @id @default(uuid())
  etfId         String   @map("etf_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  price         Decimal? @db.Decimal(14, 4)
  premium       Decimal? @db.Decimal(8, 4)
  return1d      Decimal? @map("return_1d") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  aum           Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  etf           Etf      @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([etfId, date])
  @@index([etfId, date])
  @@map("etf_performances")
}

model EtfSectorAllocation {
  id              String    @id @default(uuid()) @db.Uuid
  etfId           String    @map("etf_id")
  observationDate DateTime  @map("observation_date") @db.Date
  sectorName      String    @map("sector_name")
  /// Yahoo raw ratio normalized to the inclusive 0..1 range.
  weight          Decimal   @db.Decimal(14, 8)
  source          String
  sourceUrl       String?   @map("source_url")
  retrievedAt     DateTime? @map("retrieved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([etfId, observationDate, source, sectorName])
  @@index([etfId, observationDate])
  @@map("etf_sector_allocations")
}

model EtfCreditRatingAllocation {
  id              String    @id @default(uuid()) @db.Uuid
  etfId           String    @map("etf_id")
  observationDate DateTime  @map("observation_date") @db.Date
  creditRating    String    @map("credit_rating")
  /// Yahoo raw ratio normalized to the inclusive 0..1 range.
  weight          Decimal   @db.Decimal(14, 8)
  source          String
  sourceUrl       String?   @map("source_url")
  retrievedAt     DateTime? @map("retrieved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([etfId, observationDate, source, creditRating])
  @@index([etfId, observationDate])
  @@map("etf_credit_rating_allocations")
}

model EtfHistory {
  id            String    @id @default(uuid())
  etfId         String    @map("etf_id")
  date          DateTime  @db.Date
  nav           Decimal?  @db.Decimal(14, 4)
  price         Decimal?  @db.Decimal(14, 4)
  premium       Decimal?  @db.Decimal(8, 4)
  volume        Decimal?  @db.Decimal(20, 0)
  open          Decimal?  @db.Decimal(24, 8)
  high          Decimal?  @db.Decimal(24, 8)
  low           Decimal?  @db.Decimal(24, 8)
  close         Decimal?  @db.Decimal(24, 8)
  adjustedClose Decimal?  @map("adjusted_close") @db.Decimal(24, 8)
  source        String?
  sourceUrl     String?   @map("source_url")
  knownAt       DateTime? @map("known_at")
  aum           Decimal?  @db.Decimal(18, 2)
  dividendYield Decimal?  @map("dividend_yield") @db.Decimal(8, 4)
  return1m      Decimal?  @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal?  @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal?  @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal?  @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal?  @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal?  @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal?  @map("return_5y") @db.Decimal(8, 4)
  return10y     Decimal?  @map("return_10y") @db.Decimal(8, 4)
  sharpe        Decimal?  @db.Decimal(8, 4)
  beta          Decimal?  @db.Decimal(8, 4)
  alpha         Decimal?  @db.Decimal(8, 4)
  stdDev        Decimal?  @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown   Decimal?  @map("max_drawdown") @db.Decimal(8, 4)
  volatility    Decimal?  @db.Decimal(8, 4)
  createdAt     DateTime  @default(now()) @map("created_at")
  etf           Etf       @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([etfId, date])
