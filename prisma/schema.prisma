generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  supabaseId            String                 @unique @map("supabase_id")
  email                 String                 @unique
  displayName           String?                @map("display_name")
  avatarUrl             String?                @map("avatar_url")
  plan                  Plan                   @default(FREE)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  alerts                Alert[]
  auditLogs             AuditLog[]
  compareSessions       CompareSession[]
  favorites             Favorite[]
  investorQuestionnaire InvestorQuestionnaire?
  notifications         Notification[]
  portfolios            Portfolio[]
  savedFilters          SavedFilter[]
  searchLogs            SearchLog[]
  strategies            Strategy[]
  strategyFavorites     StrategyFavorite[]
  criteria              UserCriteria[]
  workspace             Workspace?

  @@map("users")
}

model InvestorQuestionnaire {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  answers              Json
  investorProfile      Json     @map("profile")
  questionnaireVersion Int      @default(1) @map("questionnaire_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_questionnaires")
}

model UserCriteria {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  name          String
  description   String?
  isActive      Boolean             @default(true) @map("is_active")
  version       Int                 @default(1)
  lastRunAt     DateTime?           @map("last_run_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  conditions    CriteriaCondition[]
  matches       CriteriaMatch[]
  results       CriteriaResult[]
  versions      CriteriaVersion[]
  notifications Notification[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("user_criteria")
}

model CriteriaCondition {
  id         String       @id @default(uuid())
  criteriaId String       @map("criteria_id")
  groupId    Int          @map("group_id")
  logic      Logic        @default(OR)
  field      String
  operator   String
  value      String
  valueType  String       @default("string") @map("value_type")
  period     String?
  priority   Int          @default(0)
  sortOrder  Int          @default(0) @map("sort_order")
  createdAt  DateTime     @default(now()) @map("created_at")
  criteria   UserCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([criteriaId])
  @@map("criteria_conditions")
}

model CriteriaResult {
  id          String          @id @default(uuid())
  criteriaId  String          @map("criteria_id")
  runAt       DateTime        @default(now()) @map("run_at")
  etfCount    Int             @default(0) @map("etf_count")
  fundCount   Int             @default(0) @map("fund_count")
  totalCount  Int             @default(0) @map("total_count")
  prevTotal   Int             @default(0) @map("prev_total")
  triggeredBy String          @default("user") @map("triggered_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  matches     CriteriaMatch[]
  criteria    UserCriteria    @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@index([criteriaId, runAt])
  @@map("criteria_results")
}

model CriteriaMatch {
  id               String         @id @default(uuid())
  criteriaResultId String         @map("criteria_result_id")
  criteriaId       String         @map("criteria_id")
  assetType        AssetType      @map("asset_type")
  assetId          String         @map("asset_id")
  assetName        String         @map("asset_name")
  status           MatchStatus    @default(ACTIVE)
  matchedReason    Json?          @map("matched_reason")
  removedReason    Json?          @map("removed_reason")
  firstMatchedAt   DateTime       @default(now()) @map("first_matched_at")
  lastMatchedAt    DateTime       @default(now()) @map("last_matched_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  criteria         UserCriteria   @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  result           CriteriaResult @relation(fields: [criteriaResultId], references: [id], onDelete: Cascade)

  @@index([criteriaId, status])
  @@index([assetType, assetId])
  @@map("criteria_matches")
}

model CriteriaVersion {
  id         String       @id @default(uuid())
  criteriaId String       @map("criteria_id")
  version    Int
  name       String
  conditions Json
  changedBy  String       @map("changed_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  isCurrent  Boolean      @default(true) @map("is_current")
  criteria   UserCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@map("criteria_versions")
}

model Asset {
  id               String             @id @default(uuid())
  assetType        AssetType          @map("asset_type")
  code             String?
  isin             String?
  name             String
  nameEn           String?            @map("name_en")
  provider         String?
  currency         String             @default("TWD")
  region           String?
  category         String?
  distributionFreq String?            @map("distribution_freq")
  riskLevel        Int?               @map("risk_level")
  inceptionDate    DateTime?          @map("inception_date")
  platform         String?
  sourceUrl        String?            @map("source_url")
  lastCrawledAt    DateTime?          @map("last_crawled_at")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  aum              Decimal?           @db.Decimal(18, 2)
  expenseRatio     Decimal?           @map("expense_ratio") @db.Decimal(6, 4)
  benchmark        String?
  performances     AssetPerformance[]
  distributions    Distribution[]
  etf              Etf?
  favorites        Favorite[]
  fund             Fund?
  holdings         Holding[]
  searchIndex      SearchIndex?

  @@index([assetType])
  @@index([code])
  @@index([isin])
  @@map("assets")
}

model AssetPerformance {
  id            String   @id @default(uuid())
  assetId       String   @map("asset_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  return1d      Decimal? @map("return_1d") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  aum           Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
  @@map("asset_performances")
}

model Etf {
  id               String              @id @default(uuid())
  code             String              @unique
  name             String
  nameEn           String?             @map("name_en")
  isin             String?             @unique
  provider         String
  exchange         String?
  currency         String              @default("TWD")
  category         String?
  region           String?
  sector           String?
  benchmark        String?
  distributionFreq String?             @map("distribution_freq")
  inceptionDate    DateTime?           @map("inception_date")
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  latestNav        Decimal?            @map("latest_nav") @db.Decimal(14, 4)
  latestPrice      Decimal?            @map("latest_price") @db.Decimal(14, 4)
  premium          Decimal?            @db.Decimal(8, 4)
  aum              Decimal?            @db.Decimal(18, 2)
  expenseRatio     Decimal?            @map("expense_ratio") @db.Decimal(6, 4)
  dividendYield    Decimal?            @map("dividend_yield") @db.Decimal(8, 4)
  volume           Decimal?            @db.Decimal(20, 0)
  returnYtd        Decimal?            @map("return_ytd") @db.Decimal(8, 4)
  return1m         Decimal?            @map("return_1m") @db.Decimal(8, 4)
  return3m         Decimal?            @map("return_3m") @db.Decimal(8, 4)
  return6m         Decimal?            @map("return_6m") @db.Decimal(8, 4)
  return1y         Decimal?            @map("return_1y") @db.Decimal(8, 4)
  return3y         Decimal?            @map("return_3y") @db.Decimal(8, 4)
  return5y         Decimal?            @map("return_5y") @db.Decimal(8, 4)
  return10y        Decimal?            @map("return_10y") @db.Decimal(8, 4)
  volatility1y     Decimal?            @map("volatility_1y") @db.Decimal(8, 4)
  sharpe1y         Decimal?            @map("sharpe_1y") @db.Decimal(8, 4)
  beta             Decimal?            @db.Decimal(8, 4)
  alpha            Decimal?            @db.Decimal(8, 4)
  stdDev           Decimal?            @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown      Decimal?            @map("max_drawdown") @db.Decimal(8, 4)
  priceUpdatedAt   DateTime?           @map("price_updated_at")
  assetId          String?             @unique @map("asset_id")
  dataProvider     String?             @map("data_provider")
  dataSource       String?             @map("data_source")
  knowledgeTags    AssetKnowledgeTag[]
  distributions    Distribution[]
  history          EtfHistory[]
  performances     EtfPerformance[]
  asset            Asset?              @relation(fields: [assetId], references: [id])
  holdings         Holding[]

  @@index([code])
  @@index([region, sector])
  @@index([distributionFreq])
  @@index([dividendYield])
  @@index([return1y])
  @@map("etfs")
}

model EtfPerformance {
  id            String   @id @default(uuid())
  etfId         String   @map("etf_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  price         Decimal? @db.Decimal(14, 4)
  premium       Decimal? @db.Decimal(8, 4)
  return1d      Decimal? @map("return_1d") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  aum           Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  etf           Etf      @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([etfId, date])
  @@index([etfId, date])
  @@map("etf_performances")
}

model EtfHistory {
  id            String   @id @default(uuid())
  etfId         String   @map("etf_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  price         Decimal? @db.Decimal(14, 4)
  premium       Decimal? @db.Decimal(8, 4)
  volume        Decimal? @db.Decimal(20, 0)
  aum           Decimal? @db.Decimal(18, 2)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  return10y     Decimal? @map("return_10y") @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  stdDev        Decimal? @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  createdAt     DateTime @default(now()) @map("created_at")
  etf           Etf      @relation(fields: [etfId], references: [id], onDelete: Cascade)

  @@unique([etfId, date])
  @@index([etfId, date])
  @@map("etf_history")
}

model Fund {
  id               String                @id @default(uuid())
  isin             String?               @unique
  code             String?               @unique
  name             String
  nameEn           String?               @map("name_en")
  company          String
  custodian        String?
  currency         String                @default("TWD")
  category         String?
  region           String?
  sector           String?
  distributionFreq String?               @map("distribution_freq")
  riskLevel        Int?                  @map("risk_level")
  inceptionDate    DateTime?             @map("inception_date")
  isActive         Boolean               @default(true) @map("is_active")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  latestNav        Decimal?              @map("latest_nav") @db.Decimal(14, 4)
  aum              Decimal?              @db.Decimal(18, 2)
  expenseRatio     Decimal?              @map("expense_ratio") @db.Decimal(6, 4)
  dividendYieldA   Decimal?              @map("dividend_yield_a") @db.Decimal(8, 4)
  dividendYieldM   Decimal?              @map("dividend_yield_m") @db.Decimal(8, 4)
  morningstar      Int?
  return1y         Decimal?              @map("return_1y") @db.Decimal(8, 4)
  return3y         Decimal?              @map("return_3y") @db.Decimal(8, 4)
  return5y         Decimal?              @map("return_5y") @db.Decimal(8, 4)
  return10y        Decimal?              @map("return_10y") @db.Decimal(8, 4)
  volatility1y     Decimal?              @map("volatility_1y") @db.Decimal(8, 4)
  sharpe1y         Decimal?              @map("sharpe_1y") @db.Decimal(8, 4)
  beta             Decimal?              @db.Decimal(8, 4)
  alpha            Decimal?              @db.Decimal(8, 4)
  stdDev           Decimal?              @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown      Decimal?              @map("max_drawdown") @db.Decimal(8, 4)
  navUpdatedAt     DateTime?             @map("nav_updated_at")
  assetId          String?               @unique @map("asset_id")
  dataProvider     String?               @map("data_provider")
  dataSource       String?               @map("data_source")
  latestNavDate    DateTime?             @map("latest_nav_date") @db.Date
  lastNavSource    String?               @map("last_nav_source")
  knowledgeTags    AssetKnowledgeTag[]
  distributions    Distribution[]
  history          FundHistory[]
  mapping          FundMapping?
  performances     FundPerformance[]
  providerMappings FundProviderMapping[]
  asset            Asset?                @relation(fields: [assetId], references: [id])
  holdings         Holding[]

  @@index([company])
  @@index([region, category])
  @@index([distributionFreq])
  @@index([morningstar])
  @@index([return1y])
  @@map("funds")
}

model FundPerformance {
  id            String   @id @default(uuid())
  fundId        String   @map("fund_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  return1d      Decimal? @map("return_1d") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  return10y     Decimal? @map("return_10y") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  stdDev        Decimal? @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  aum           Decimal? @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, date])
  @@index([fundId, date])
  @@map("fund_performances")
}

model FundHistory {
  id            String   @id @default(uuid())
  fundId        String   @map("fund_id")
  date          DateTime @db.Date
  nav           Decimal? @db.Decimal(14, 4)
  aum           Decimal? @db.Decimal(18, 2)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  return1m      Decimal? @map("return_1m") @db.Decimal(8, 4)
  return3m      Decimal? @map("return_3m") @db.Decimal(8, 4)
  return6m      Decimal? @map("return_6m") @db.Decimal(8, 4)
  returnYtd     Decimal? @map("return_ytd") @db.Decimal(8, 4)
  return1y      Decimal? @map("return_1y") @db.Decimal(8, 4)
  return3y      Decimal? @map("return_3y") @db.Decimal(8, 4)
  return5y      Decimal? @map("return_5y") @db.Decimal(8, 4)
  return10y     Decimal? @map("return_10y") @db.Decimal(8, 4)
  sharpe        Decimal? @db.Decimal(8, 4)
  beta          Decimal? @db.Decimal(8, 4)
  alpha         Decimal? @db.Decimal(8, 4)
  stdDev        Decimal? @map("std_dev") @db.Decimal(8, 4)
  maxDrawdown   Decimal? @map("max_drawdown") @db.Decimal(8, 4)
  volatility    Decimal? @db.Decimal(8, 4)
  morningstar   Int?
  createdAt     DateTime @default(now()) @map("created_at")
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, date])
  @@index([fundId, date])
  @@map("fund_history")
}

model FundMapping {
  id             String   @id @default(uuid())
  fundId         String   @unique @map("fund_id")
  moneydjCode    String?  @map("moneydj_code")
  status         String
  candidateCount Int?     @map("candidate_count")
  lastCheckedAt  DateTime @default(now()) @map("last_checked_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  fund           Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fund_mappings")
}

model FundProviderMapping {
  id             String   @id @default(uuid())
  fundId         String   @map("fund_id")
  provider       String
  providerCode   String   @map("provider_code")
  status         String
  candidateCount Int?     @map("candidate_count")
  lastCheckedAt  DateTime @default(now()) @map("last_checked_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  fund           Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, provider])
  @@index([provider, status])
  @@index([providerCode])
  @@map("fund_provider_mappings")
}

model HistoryJob {
  id               String               @id @default(uuid())
  provider         String
  status           String
  totalCount       Int                  @map("total_count")
  processedCount   Int                  @default(0) @map("processed_count")
  successCount     Int                  @default(0) @map("success_count")
  failedCount      Int                  @default(0) @map("failed_count")
  lastProviderCode String?              @map("last_provider_code")
  startedAt        DateTime             @default(now()) @map("started_at")
  finishedAt       DateTime?            @map("finished_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  failedJobs       HistoryFailedQueue[]

  @@index([provider, status])
  @@map("history_jobs")
}

model HistoryFailedQueue {
  id            String     @id @default(uuid())
  jobId         String     @map("job_id")
  fundId        String     @map("fund_id")
  providerCode  String     @map("provider_code")
  errorCategory String     @map("error_category")
  errorMessage  String?    @map("error_message")
  attempts      Int        @default(0)
  resolvedAt    DateTime?  @map("resolved_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  job           HistoryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, resolvedAt])
  @@index([providerCode])
  @@map("history_failed_queue")
}

model Security {
  id                String             @id @default(uuid())
  ticker            String?
  isin              String?
  cusip             String?
  sedol             String?
  name              String
  nameEn            String?            @map("name_en")
  exchange          String?
  country           String?
  sector            String?
  industry          String?
  currency          String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  holdings          Holding[]
  insuranceHoldings InsuranceHolding[]

  @@index([ticker])
  @@index([isin])
  @@index([sector])
  @@index([industry])
  @@map("securities")
}

model Distribution {
  id        String    @id @default(uuid())
  assetType AssetType @map("asset_type")
  etfId     String?   @map("etf_id")
  fundId    String?   @map("fund_id")
  exDate    DateTime  @map("ex_date") @db.Date
  payDate   DateTime? @map("pay_date") @db.Date
  amount    Decimal   @db.Decimal(10, 6)
  frequency String?
  yieldRate Decimal?  @map("yield_rate") @db.Decimal(8, 4)
  currency  String    @default("TWD")
  createdAt DateTime  @default(now()) @map("created_at")
  assetId   String?   @map("asset_id")
  asset     Asset?    @relation(fields: [assetId], references: [id])
  etf       Etf?      @relation(fields: [etfId], references: [id])
  fund      Fund?     @relation(fields: [fundId], references: [id])

  @@index([assetType, etfId])
  @@index([assetType, fundId])
  @@index([assetId])
  @@map("distributions")
}

model Holding {
  id          String    @id @default(uuid())
  assetType   AssetType @map("asset_type")
  etfId       String?   @map("etf_id")
  fundId      String?   @map("fund_id")
  asOfDate    DateTime  @map("as_of_date") @db.Date
  rank        Int
  /// @deprecated 改用 securityId + Security 關聯，保留供過渡期相容
  holdingName String    @map("holding_name")
  /// @deprecated 改用 securityId + Security 關聯，保留供過渡期相容
  holdingCode String?   @map("holding_code")
  weight      Decimal   @db.Decimal(8, 4)
  sector      String?
  country     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  assetId     String?   @map("asset_id")
  securityId  String?   @map("security_id")
  asset       Asset?    @relation(fields: [assetId], references: [id])
