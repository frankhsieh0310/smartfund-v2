  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
  TAX
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  SPLIT
  ADJUSTMENT
}

enum PortfolioLotStatus {
  OPEN
  CLOSED
}

enum DataAvailability {
  AVAILABLE
  PARTIAL
  UPDATING
  SCHEDULED_WAIT
  SOURCE_LIMITED
  NOT_AVAILABLE
}

model PortfolioTransaction {
  id             String                   @id @default(uuid())
  portfolioId    String                   @map("portfolio_id")
  type           PortfolioTransactionType
  assetType      AssetType?               @map("asset_type")
  assetId        String?                  @map("asset_id")
  quantity       Decimal?                 @db.Decimal(28, 10)
  price          Decimal?                 @db.Decimal(28, 10)
  amount         Decimal                  @db.Decimal(28, 10)
  fees           Decimal                  @default(0) @db.Decimal(28, 10)
  tax            Decimal                  @default(0) @db.Decimal(28, 10)
  currency       String
