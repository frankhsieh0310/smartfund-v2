{
  "version": 1,
  "policy":"Formula outputs retain formula_version, dependency timestamps, source fact IDs and validation status.",
  "formulas":[
    {"id":"market_cap","formula":"close_price * shares_outstanding","raw":["close_price","shares_outstanding"],"refresh":"daily","pointInTime":true,"validation":"market_cap_reference_comparison"},
    {"id":"pe_ttm","formula":"close_price / diluted_eps_ttm","raw":["close_price","diluted_eps"],"refresh":"daily/filing","pointInTime":true,"validation":"provider_and_manual_recalculation"},
    {"id":"pb","formula":"close_price / (shareholders_equity / shares_outstanding)","raw":["close_price","shareholders_equity","shares_outstanding"],"refresh":"daily/filing","pointInTime":true,"validation":"provider_and_manual_recalculation"},
    {"id":"ps_ttm","formula":"market_cap / revenue_ttm","raw":["close_price","shares_outstanding","revenue"],"refresh":"daily/filing","pointInTime":true,"validation":"provider_and_manual_recalculation"},
    {"id":"enterprise_value","formula":"market_cap + total_debt + preferred_equity + minority_interest - cash_and_short_term_investments","raw":["close_price","shares_outstanding","short_term_debt","long_term_debt","preferred_shares_outstanding","minority_interest","cash_and_cash_equivalents","short_term_investments"],"refresh":"daily/filing","pointInTime":true,"validation":"provider_and_manual_recalculation"},
    {"id":"ev_ebitda","formula":"enterprise_value / ebitda_ttm","raw":["enterprise_value","operating_income","depreciation_expense","amortization_expense"],"refresh":"daily/filing","pointInTime":true,"validation":"provider_comparison"},
    {"id":"gross_margin","formula":"gross_profit / revenue","raw":["gross_profit","revenue"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"operating_margin","formula":"operating_income / revenue","raw":["operating_income","revenue"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"net_margin","formula":"net_income_common / revenue","raw":["net_income_common","revenue"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"roe","formula":"net_income_ttm / average_shareholders_equity","raw":["net_income","shareholders_equity"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"roa","formula":"net_income_ttm / average_total_assets","raw":["net_income","total_assets"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"current_ratio","formula":"current_assets / current_liabilities","raw":["current_assets","current_liabilities"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"quick_ratio","formula":"(cash_and_cash_equivalents + short_term_investments + accounts_receivable) / current_liabilities","raw":["cash_and_cash_equivalents","short_term_investments","accounts_receivable","current_liabilities"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"debt_equity","formula":"total_debt / shareholders_equity","raw":["short_term_debt","long_term_debt","shareholders_equity"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"interest_coverage","formula":"ebit_ttm / interest_expense_ttm","raw":["operating_income","interest_expense"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"free_cash_flow","formula":"operating_cash_flow - capital_expenditure","raw":["operating_cash_flow","capital_expenditure"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"dividend_yield","formula":"cash_dividend_per_share_ttm / close_price","raw":["cash_dividend_per_share","close_price"],"refresh":"daily/event","pointInTime":true,"validation":"event_adjusted_price_check"},
    {"id":"total_return","formula":"price_return + reinvested_cash_dividends","raw":["adjusted_close_price","cash_dividend_per_share","split_ratio"],"refresh":"daily/event","pointInTime":true,"validation":"adjusted_price_comparison"},
    {"id":"ebitda","formula":"operating_income + depreciation_expense + amortization_expense","raw":["operating_income","depreciation_expense","amortization_expense"],"refresh":"filing","pointInTime":true,"validation":"provider_comparison"},
    {"id":"ebit","formula":"operating_income","raw":["operating_income"],"refresh":"filing","pointInTime":true,"validation":"taxonomy_mapping_review"},
    {"id":"book_value_per_share","formula":"shareholders_equity / shares_outstanding","raw":["shareholders_equity","shares_outstanding"],"refresh":"filing","pointInTime":true,"validation":"provider_comparison"},
    {"id":"earnings_yield","formula":"diluted_eps_ttm / close_price","raw":["diluted_eps","close_price"],"refresh":"daily/filing","pointInTime":true,"validation":"inverse_pe_check"},
    {"id":"fcf_yield","formula":"free_cash_flow_ttm / market_cap","raw":["operating_cash_flow","capital_expenditure","close_price","shares_outstanding"],"refresh":"daily/filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"cash_ratio","formula":"(cash_and_cash_equivalents + short_term_investments) / current_liabilities","raw":["cash_and_cash_equivalents","short_term_investments","current_liabilities"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"debt_assets","formula":"total_debt / total_assets","raw":["short_term_debt","long_term_debt","total_assets"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"net_debt_ebitda","formula":"(total_debt - cash_and_cash_equivalents) / ebitda_ttm","raw":["short_term_debt","long_term_debt","cash_and_cash_equivalents","operating_income","depreciation_expense","amortization_expense"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"asset_turnover","formula":"revenue_ttm / average_total_assets","raw":["revenue","total_assets"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"inventory_turnover","formula":"cost_of_revenue_ttm / average_inventory","raw":["cost_of_revenue","inventory"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"receivable_turnover","formula":"revenue_ttm / average_accounts_receivable","raw":["revenue","accounts_receivable"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"payout_ratio","formula":"dividends_paid_ttm / net_income_common_ttm","raw":["dividends_paid","net_income_common"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"retention_ratio","formula":"1 - payout_ratio","raw":["dividends_paid","net_income_common"],"refresh":"filing","pointInTime":true,"validation":"manual_recalculation"},
    {"id":"revenue_growth_yoy","formula":"(revenue_current_period / revenue_comparable_prior_period) - 1","raw":["revenue","period_end"],"refresh":"filing","pointInTime":true,"validation":"period_alignment_check"},
    {"id":"eps_growth_yoy","formula":"(diluted_eps_current_period / diluted_eps_comparable_prior_period) - 1","raw":["diluted_eps","period_end"],"refresh":"filing","pointInTime":true,"validation":"period_alignment_check"},
    {"id":"book_value_growth","formula":"(shareholders_equity_current / shareholders_equity_prior) - 1","raw":["shareholders_equity","period_end"],"refresh":"filing","pointInTime":true,"validation":"period_alignment_check"},
    {"id":"share_count_growth","formula":"(shares_outstanding_current / shares_outstanding_prior) - 1","raw":["shares_outstanding","period_end"],"refresh":"filing","pointInTime":true,"validation":"period_alignment_check"},
    {"id":"price_return","formula":"adjusted_close_end / adjusted_close_start - 1","raw":["adjusted_close_price","split_ratio","cash_dividend_per_share"],"refresh":"daily","pointInTime":true,"validation":"adjusted_price_comparison"},
    {"id":"historical_volatility","formula":"standard_deviation(log_returns, window) * sqrt(trading_days)","raw":["adjusted_close_price"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"max_drawdown","formula":"minimum(adjusted_close / running_peak - 1)","raw":["adjusted_close_price"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"beta","formula":"covariance(asset_returns, benchmark_returns) / variance(benchmark_returns)","raw":["adjusted_close_price","benchmark_adjusted_close_price"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"sharpe","formula":"(annualized_return - risk_free_rate) / annualized_volatility","raw":["adjusted_close_price","risk_free_rate"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"sortino","formula":"(annualized_return - risk_free_rate) / downside_deviation","raw":["adjusted_close_price","risk_free_rate"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"tracking_error","formula":"standard_deviation(asset_returns - benchmark_returns)","raw":["adjusted_close_price","benchmark_adjusted_close_price"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"information_ratio","formula":"mean(asset_returns - benchmark_returns) / tracking_error","raw":["adjusted_close_price","benchmark_adjusted_close_price"],"refresh":"daily","pointInTime":true,"validation":"independent_series_recalculation"},
    {"id":"valuation_percentile","formula":"rank(current_multiple within point_in_time_historical_multiples)","raw":["close_price","shares_outstanding","statement_raw_facts"],"refresh":"daily/filing","pointInTime":true,"validation":"lookahead_bias_check"}
  ],
  "nonRecoverable":["analyst_revision","recommendation_change","target_price_revision","institutional_holder_change_without_filing","consensus_estimate","forward_pe","peer_rank_without_peer_universe","factor_exposure_without_model_definition","insider_sentiment","short_interest_between_publication_dates"]
}
