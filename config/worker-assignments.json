      "status": "ACTIVE",
      "assignment": {
        "domain": "FINANCIAL",
        "market": "NASDAQ",
        "mode": "HISTORICAL"
      }
    },
    {
      "name": "WORKER-02",
      "nodeId": "worker-02-desktop",
