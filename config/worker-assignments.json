      "status": "ACTIVE",
      "assignments": [
        "simple-time-series-global-historical",
        "simple-time-series-global-latest-canary",
        "simple-time-series-global-validation"
      ],
      "scopedAssignments": [
        { "domain": "SIMPLE_TIME_SERIES", "market": "GLOBAL_INDICES", "mode": "HISTORICAL" },
