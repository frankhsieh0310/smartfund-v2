      "pausedAssignments": [
        {
          "domain": "FINANCIAL",
          "market": "NYSE",
          "mode": "HISTORICAL",
          "status": "PAUSED_BY_PRIORITY_REALLOCATION",
          "checkpoint": "EMR / 825"
        }
      ],
      "authorizedQueue": [
        "GLOBAL_INDICES",
        "VOLATILITY",
        "FX_EXPANSION",
        "COMMODITY_EXPANSION",
        "CRYPTO_EXPANSION",
        "GOVERNMENT_YIELD_EXPANSION",
        "POLICY_MONEY_MARKET_RATES",
        "CREDIT_SPREADS",
        "ECONOMIC_EXPANSION",
        "SHIPPING_ENERGY_HOUSING_LIQUIDITY"
