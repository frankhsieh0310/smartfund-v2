{
  "version": 1,
  "policy": {
    "scopeKey": ["domain", "market", "mode"],
    "exclusiveOwnerPerScope": true,
    "unknownNodesMayWrite": false,
    "fallbackScopesForbidden": ["ALL", "US", "GLOBAL"]
  },
  "nodes": [
    {
      "name": "MASTER",
      "nodeId": "smartfund-master",
      "role": "MASTER",
      "status": "ACTIVE",
