        "global-roadmap",
        "worker-assignment",
        "railway-handoff"
      ],
      "scopedAssignments": [
        { "domain": "BOND", "market": "US_TREASURY", "mode": "HISTORICAL" },
        { "domain": "BOND", "market": "US_TREASURY", "mode": "INCREMENTAL" }
      ]
    },
    {
      "name": "RAILWAY",
      "nodeId": "railway-production",
      "role": "PRODUCTION",
      "status": "ACTIVE",
      "assignments": [
        "stock-daily",
        "asset-daily",
        "macro-incremental",
        "financial-incremental",
        "retry",
        "scheduler"
      ],
      "scopedAssignments": [
        { "domain": "FINANCIAL", "market": "NASDAQ", "mode": "INCREMENTAL" },
        { "domain": "FINANCIAL", "market": "NYSE", "mode": "INCREMENTAL" },
        { "domain": "FINANCIAL", "market": "AMEX", "mode": "INCREMENTAL" }
      ]
    },
    {
      "name": "WORKER-01",
