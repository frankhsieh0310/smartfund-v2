{
  "version": "1.0.0",
  "enabled": true,
  "readOnly": true,
  "minAssets": 2,
  "maxAssets": 10,
  "batchSize": 5,
  "checkpointEvery": 1,
  "pollIntervalMs": 300000,
  "databaseBackoffMs": [5000, 15000, 60000, 300000],
  "maxAttempts": 3,
  "maxConsecutiveDatabaseFailures": 5,
  "circuitOpenMs": 1800000,
  "cacheTtlSeconds": 86400,
  "defaultPeriods": ["1M", "3M", "6M", "YTD", "1Y", "3Y", "5Y", "10Y", "SINCE_INCEPTION"],
  "comparisonCurrencies": ["ORIGINAL", "TWD", "USD"],
  "timeAlignment": {
    "method": "intersection_asof",
    "timezone": "UTC",
    "missingDate": "SKIP_DATE",
    "newAsset": "AVAILABLE_WINDOW_ONLY",
    "forwardFill": false,
    "futureFill": false,
    "frequency": "DAILY_OR_LOWEST_COMMON"
  },
  "currencyNormalization": {
    "source": "fx_candles",
    "method": "historical_asof_no_future_fill",
    "includeFxEffectDefault": false,
    "prohibitLatestRateHistoricalBackfill": true
  },
  "scheduler": {
    "service": "smartfund-v2",
    "newService": false,
    "singleDatabaseWriter": true,
    "command": ["node", "--experimental-strip-types", "--env-file=.env", "scripts/data/compare/run-global-compare-engine.ts", "--daemon", "--resume"]
  },
  "assetMappings": {
    "STOCK": { "identity": "stocks", "series": "stock_history.adjusted_close|close", "performance": "derived", "risk": "derived", "fundamental": "stock_financial_facts", "technical": "stock_technical" },
    "ETF": { "identity": "etfs", "series": "etf_history.price|nav", "performance": "etf_performances|derived", "allocation": "holdings", "income": "distributions" },
    "FUND": { "identity": "funds", "series": "fund_history.nav", "performance": "fund_performances|derived", "allocation": "holdings", "income": "distributions", "missing": "UNKNOWN" },
    "BOND": { "identity": "market_master[type=BOND]", "series": "market_data[type=BOND]" },
    "GOVERNMENT_YIELD": { "identity": "market_master[type=BOND]", "series": "market_data[type=BOND]" },
    "COMMODITY": { "identity": "market_master[type=COMMODITY]", "series": "market_data[type=COMMODITY]" },
    "FX": { "identity": "fx_pairs", "series": "fx_candles" },
    "CRYPTO": { "identity": "crypto_assets|crypto_markets", "series": "crypto_candles" },
    "GLOBAL_INDEX": { "identity": "market_master[type=INDEX]", "series": "market_data[type=INDEX]" },
    "REIT": { "identity": "assets[type=REIT]", "series": "asset_performances" },
    "FUTURES": { "identity": "market_master", "series": "market_data" },
    "ECONOMIC": { "identity": "economic_series", "series": "economic_observations" },
    "EVENT": { "identity": "economic_indicators", "series": "economic_indicators" }
  },
  "crossAssetAllowed": ["historical_return", "volatility", "max_drawdown", "sharpe", "correlation", "currency", "liquidity", "income_yield", "freshness", "data_quality"],
  "p0Contract": {
    "canonicalCompareOwner": "lib/data-platform/web/compareService.ts",
    "identityKey": ["assetType", "canonicalEntityId"],
    "periods": ["1D", "1W", "1M", "3M", "6M", "YTD", "1Y", "3Y", "5Y", "10Y", "MAX", "CUSTOM"],
    "alignmentPolicies": ["EXACT_INTERSECTION", "PER_ITEM_AS_OF", "PREVIOUS_AVAILABLE_NO_FUTURE_FILL"],
    "correlationAlignment": "EXACT_INTERSECTION",
    "correlationMinimumSample": 20,
    "normalizationPolicies": ["NATIVE_NOT_NORMALIZED", "SAME_CURRENCY", "FX_NORMALIZED"],
    "defaultNormalizationPolicy": "NATIVE_NOT_NORMALIZED",
    "futureFill": false,
    "riskFreeRatePolicy": "SHARPE_NOT_READY_UNTIL_VERIFIED_CONTRACT"
  },
  "supportedAssetMatrix": {
    "STOCK": "READY_NOW",
    "ETF": "READY_NOW",
    "FUND": "READY_NOW",
    "INDEX": "READY_NOW",
    "FX": "READY_NOW",
    "CRYPTO": "PARTIAL_READY",
    "BOND": "BLOCKED_UPSTREAM",
    "GOVERNMENT_YIELD": "BLOCKED_UPSTREAM",
    "COMMODITY": "BLOCKED_UPSTREAM",
    "REIT": "BLOCKED_UPSTREAM",
    "FUTURES": "BLOCKED_UPSTREAM",
    "ECONOMIC": "PARTIAL_READY",
    "EVENT": "NOT_APPLICABLE"
  },
  "registryDefaults": { "currencyRule": "NATIVE_OR_HISTORICAL_FX", "frequency": "LATEST_OR_DAILY", "sourcePriority": ["CANONICAL_DB", "DERIVED_CANONICAL"], "missingDataRule": "UNKNOWN", "displayFormat": "AUTO" },
  "registry": [
    { "id":"identity", "category":"Identity", "assets":["ALL"], "unit":"TEXT", "calculation":"CANONICAL", "direction":"NONE" },
    { "id":"price", "category":"Price", "assets":["STOCK","ETF","BOND","COMMODITY","FX","CRYPTO","GLOBAL_INDEX","REIT","FUTURES"], "unit":"CURRENCY", "calculation":"LATEST_ALIGNED", "direction":"NONE" },
    { "id":"nav", "category":"Price", "assets":["ETF","FUND"], "unit":"CURRENCY", "calculation":"LATEST_ALIGNED", "direction":"NONE" },
    { "id":"historical_return", "category":"Performance", "assets":["ALL_SERIES"], "unit":"PERCENT", "calculation":"END/START-1", "direction":"HIGHER" },
    { "id":"rolling_return", "category":"Performance", "assets":["ALL_SERIES"], "unit":"PERCENT", "calculation":"ROLLING_END/START-1", "direction":"HIGHER" },
    { "id":"normalized_growth", "category":"Performance", "assets":["ALL_SERIES"], "unit":"INDEX", "calculation":"VALUE/FIRST*100", "direction":"HIGHER" },
    { "id":"relative_strength", "category":"Performance", "assets":["ALL_SERIES"], "unit":"RATIO", "calculation":"NORMALIZED_A/NORMALIZED_B", "direction":"HIGHER" },
    { "id":"volatility", "category":"Risk", "assets":["ALL_SERIES"], "unit":"PERCENT", "calculation":"STDDEV_DAILY_RETURN*SQRT(252)", "direction":"LOWER" },
    { "id":"sharpe", "category":"Risk", "assets":["ALL_SERIES"], "unit":"RATIO", "calculation":"ANNUALIZED_RETURN/ANNUALIZED_VOLATILITY", "direction":"HIGHER" },
    { "id":"max_drawdown", "category":"Risk", "assets":["ALL_SERIES"], "unit":"PERCENT", "calculation":"MIN(VALUE/RUNNING_MAX-1)", "direction":"HIGHER" },
    { "id":"correlation", "category":"Risk", "assets":["ALL_SERIES"], "unit":"RATIO", "calculation":"PEARSON_ALIGNED_RETURNS", "direction":"NONE" },
    { "id":"beta", "category":"Risk", "assets":["STOCK","ETF","FUND"], "unit":"RATIO", "calculation":"CANONICAL_OR_COVARIANCE", "direction":"NONE" },
    { "id":"market_cap", "category":"Valuation", "assets":["STOCK"], "unit":"CURRENCY", "calculation":"CANONICAL_FACT", "direction":"NONE" },
    { "id":"pe", "category":"Valuation", "assets":["STOCK"], "unit":"RATIO", "calculation":"CANONICAL_FACT", "direction":"LOWER" },
    { "id":"pb", "category":"Valuation", "assets":["STOCK"], "unit":"RATIO", "calculation":"CANONICAL_FACT", "direction":"LOWER" },
    { "id":"ps", "category":"Valuation", "assets":["STOCK"], "unit":"RATIO", "calculation":"CANONICAL_FACT", "direction":"LOWER" },
    { "id":"revenue", "category":"Fundamental", "assets":["STOCK"], "unit":"CURRENCY", "calculation":"LATEST_CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"eps", "category":"Fundamental", "assets":["STOCK"], "unit":"CURRENCY_PER_SHARE", "calculation":"LATEST_CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"roe", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"roa", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"margin", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"debt_ratio", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"CANONICAL_FACT", "direction":"LOWER" },
    { "id":"revenue_growth", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"YOY_CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"eps_growth", "category":"Fundamental", "assets":["STOCK"], "unit":"PERCENT", "calculation":"YOY_CANONICAL_FACT", "direction":"HIGHER" },
    { "id":"dividend_yield", "category":"Income", "assets":["STOCK","ETF","FUND"], "unit":"PERCENT", "calculation":"CANONICAL", "direction":"HIGHER" },
    { "id":"distribution", "category":"Income", "assets":["ETF","FUND"], "unit":"CURRENCY", "calculation":"CANONICAL", "direction":"NONE" },
    { "id":"income_yield", "category":"Income", "assets":["ALL"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"aum", "category":"Liquidity", "assets":["ETF","FUND"], "unit":"CURRENCY", "calculation":"CANONICAL", "direction":"HIGHER" },
    { "id":"volume", "category":"Liquidity", "assets":["STOCK","ETF","COMMODITY","CRYPTO","GLOBAL_INDEX","REIT","FUTURES"], "unit":"UNITS", "calculation":"LATEST_ALIGNED", "direction":"HIGHER" },
    { "id":"liquidity", "category":"Liquidity", "assets":["ALL"], "unit":"CLASS", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"expense_ratio", "category":"Cost", "assets":["ETF","FUND"], "unit":"PERCENT", "calculation":"CANONICAL", "direction":"LOWER" },
    { "id":"fee", "category":"Cost", "assets":["FUND"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"premium_discount", "category":"Valuation", "assets":["ETF"], "unit":"PERCENT", "calculation":"PRICE/NAV-1", "direction":"LOWER_ABS" },
    { "id":"tracking_difference", "category":"Performance", "assets":["ETF"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"LOWER_ABS" },
    { "id":"tracking_error", "category":"Risk", "assets":["ETF"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"flow", "category":"Liquidity", "assets":["ETF"], "unit":"CURRENCY", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"holdings_count", "category":"Holdings", "assets":["ETF","FUND"], "unit":"COUNT", "calculation":"COUNT_LATEST_HOLDINGS", "direction":"NONE" },
    { "id":"top_holdings", "category":"Holdings", "assets":["ETF","FUND"], "unit":"LIST", "calculation":"LATEST_HOLDINGS", "direction":"NONE" },
    { "id":"holdings_overlap", "category":"Holdings", "assets":["ETF","FUND"], "unit":"PERCENT", "calculation":"SUM_MIN_NORMALIZED_WEIGHTS", "direction":"NONE" },
    { "id":"country_allocation", "category":"Allocation", "assets":["ETF","FUND"], "unit":"PERCENT_MAP", "calculation":"GROUP_LATEST_HOLDINGS", "direction":"NONE" },
    { "id":"sector_allocation", "category":"Allocation", "assets":["ETF","FUND"], "unit":"PERCENT_MAP", "calculation":"GROUP_LATEST_HOLDINGS", "direction":"NONE" },
    { "id":"asset_allocation", "category":"Allocation", "assets":["ETF","FUND"], "unit":"PERCENT_MAP", "calculation":"CANONICAL_ONLY", "direction":"NONE" },
    { "id":"benchmark", "category":"Identity", "assets":["ETF","FUND"], "unit":"TEXT", "calculation":"CANONICAL", "direction":"NONE" },
    { "id":"category", "category":"Identity", "assets":["ETF","FUND"], "unit":"TEXT", "calculation":"CANONICAL", "direction":"NONE" },
    { "id":"yield", "category":"Income", "assets":["BOND","GOVERNMENT_YIELD"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"coupon", "category":"Income", "assets":["BOND"], "unit":"PERCENT", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"maturity", "category":"Identity", "assets":["BOND"], "unit":"DATE", "calculation":"CANONICAL_ONLY", "direction":"NONE" },
    { "id":"duration", "category":"Risk", "assets":["BOND"], "unit":"YEARS", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"credit_rating", "category":"Risk", "assets":["BOND"], "unit":"RATING", "calculation":"CANONICAL_ONLY", "direction":"HIGHER" },
    { "id":"seniority", "category":"Identity", "assets":["BOND"], "unit":"TEXT", "calculation":"CANONICAL_ONLY", "direction":"NONE" },
    { "id":"callable", "category":"Identity", "assets":["BOND"], "unit":"BOOLEAN", "calculation":"CANONICAL_ONLY", "direction":"NONE" },
    { "id":"spread", "category":"Risk", "assets":["BOND"], "unit":"BPS", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"interest_rate_risk", "category":"Risk", "assets":["BOND"], "unit":"CLASS", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"credit_risk", "category":"Risk", "assets":["BOND"], "unit":"CLASS", "calculation":"CANONICAL_ONLY", "direction":"LOWER" },
    { "id":"technical_indicators", "category":"Technical", "assets":["STOCK"], "unit":"OBJECT", "calculation":"LATEST_STOCK_TECHNICAL", "direction":"NONE" },
    { "id":"event", "category":"Event", "assets":["STOCK","ETF","FUND","ECONOMIC","EVENT"], "unit":"OBJECT", "calculation":"CANONICAL_ONLY", "direction":"NONE" },
    { "id":"currency", "category":"Identity", "assets":["ALL"], "unit":"ISO4217", "calculation":"CANONICAL", "direction":"NONE" },
    { "id":"data_quality", "category":"Source Quality", "assets":["ALL"], "unit":"SCORE", "calculation":"COMPLETENESS_AND_LINEAGE", "direction":"HIGHER" },
    { "id":"freshness", "category":"Freshness", "assets":["ALL"], "unit":"TIMESTAMP", "calculation":"LATEST_SOURCE_TIMESTAMP", "direction":"HIGHER" }
  ]
}
