FROM node:22-bookworm-slim

WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" DIRECT_URL="postgresql://build:build@localhost:5432/build" npx prisma generate

# Bond production never runs migrations. Schema changes remain an owner gate.
CMD ["node", "--experimental-strip-types", "scripts/data/bond/run-production-us-treasury.ts"]
